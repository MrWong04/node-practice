# ===========================================================================
# .env.example — 环境变量模板文件
# ===========================================================================
# 本文件不含真实敏感信息，用于向团队成员说明项目所需的全部环境变量。
# 复制本文件为 .env 后填入实际值即可在本地运行项目。
# ===========================================================================

# ---------------------------------------------------------------------------
# 应用基础配置
# ---------------------------------------------------------------------------

# NODE_ENV — 运行环境
# 可选值: development | production | test
# development: 启用详细日志、Prisma 查询日志
# production:  最小化日志输出，关闭查询日志
NODE_ENV=development

# PORT — 应用监听端口
# 默认 3002，可通过此变量修改
PORT=3002

# ---------------------------------------------------------------------------
# 数据库配置
# ---------------------------------------------------------------------------

# DATABASE_URL — Prisma 数据库连接字符串
# 格式: <provider>://<user>:<password>@<host>:<port>/<database>
# 开发环境示例（MySQL）: mysql://root:password@localhost:3306/node_practice
# 如果使用 SQLite: file:./dev.db
DATABASE_URL="mysql://root:your_password@localhost:3306/node_practice"

# ---------------------------------------------------------------------------
# 认证与安全配置
# ---------------------------------------------------------------------------

# JWT_SECRET — JWT 签名密钥
# 要求: 长度至少 32 个字符的强随机字符串
# 生成建议: openssl rand -base64 64
# ⚠️ 生产环境务必修改，绝不能使用默认值
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-32-chars

# JWT_EXPIRES_IN — Token 有效期
# 格式遵循 vercel/ms 语法: 7d, 24h, 60m
JWT_EXPIRES_IN=7d

# BCRYPT_SALT_ROUNDS — bcrypt 哈希轮数
# 数值越大越安全但越慢，推荐 10-12
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------------------------------
# CORS 配置（如需）
# ---------------------------------------------------------------------------

# CORS_ORIGIN — 允许的跨域来源
# 开发环境可设为 * 或前端地址如 http://localhost:5173
# 生产环境应指定具体域名
CORS_ORIGIN="http://localhost:5173"
