{
  // ==========================================================================
  // tsconfig.json — TypeScript 编译器配置文件
  // ==========================================================================
  // 作用: 告诉 tsc 如何编译 TypeScript 源代码
  // 参考文档: https://www.typescriptlang.org/tsconfig
  // ==========================================================================
  "compilerOptions": {
    // --------------------------------------------------------------------------
    // 基础编译目标
    // --------------------------------------------------------------------------

    // target — 编译后的 JavaScript 目标版本
    // ES2020 支持 Promise.allSettled, BigInt, Optional Chaining 等现代特性
    // Node.js 14+ 完全支持 ES2020
    "target": "ES2020",

    // module — 模块系统
    // "Node16" 是 TypeScript 5.0+ 推荐的 Node.js 项目模块策略
    // 它会根据 package.json 中是否有 "type": "module" 自动输出 CommonJS 或 ESM
    // 当前项目无 "type": "module"，因此输出仍为 CommonJS（require/module.exports）
    // 同时正确处理 ESM/CJS 的互操作，无弃用警告
    "module": "Node16",

    // lib — 编译时包含的 JavaScript 内置 API 声明
    // ES2020 提供 Array.prototype.flat, Object.fromEntries 等类型定义
    // 不添加 DOM 库，因为这是一个纯后端项目
    "lib": ["ES2020"],

    // allowJs — 允许编译 .js 文件
    // 使 src/ 下的 .js 文件（如 app-prisma.js）纳入 TypeScript 项目
    // 这样 @typescript-eslint/parser 的 project 模式也能找到这些文件
    "allowJs": true,

    // --------------------------------------------------------------------------
    // 输出配置
    // --------------------------------------------------------------------------

    // outDir — 编译输出目录
    // 所有 .ts 文件编译后的 .js 文件将输出到 dist/ 目录
    // package.json 中的 "main": "dist/app.js" 指向此目录
    "outDir": "./dist",

    // rootDir — 源码根目录（可选，用于保持输出目录结构）
    // 不设置时，tsc 会相对于 tsconfig.json 的位置保留目录结构

    // --------------------------------------------------------------------------
    // 严格类型检查（强烈建议全部开启）
    // --------------------------------------------------------------------------

    // strict — 启用所有严格类型检查选项的开关
    // 等同于同时开启: noImplicitAny, strictNullChecks, strictFunctionTypes,
    // strictBindCallApply, strictPropertyInitialization, noImplicitThis, alwaysStrict
    // 开启 strict 是减少运行时错误的最有效手段
    "strict": true,

    // --------------------------------------------------------------------------
    // 模块解析
    // --------------------------------------------------------------------------

    // moduleResolution — 模块解析策略
    // "Node16" 与上面的 "module": "Node16" 配对使用
    // 这是 TypeScript 官方推荐的 Node.js 项目配置组合
    // 支持完整的 Node.js 模块解析算法（包括 node_modules, package.json exports 等）
    "moduleResolution": "Node16",

    // baseUrl — 非相对路径模块的基础目录
    // 以 tsconfig.json 所在目录为基准，用于配合 paths 使用
    // TypeScript 6.0 对此选项有弃用警告，但 paths 映射仍依赖它
    // 通过 ignoreDeprecations 静默过渡期的弃用提示
    "baseUrl": ".",

    // paths — 模块路径别名映射
    // 允许使用 "@/middleware/auth" 代替 "../../../src/middleware/auth"
    // 需要配合 tsconfig-paths 或 bundler 使用才能在运行时生效
    "paths": {
      // "@/*" 映射到 "src/*"，项目中可使用 @/routes/user 代替相对路径
      "@/*": ["src/*"]
    },

    // --------------------------------------------------------------------------
    // 互操作性与兼容性
    // --------------------------------------------------------------------------

    // esModuleInterop — 改善 ES Module 与 CommonJS 的互操作性
    // 允许使用 import 语法导入 CommonJS 模块（如 import express from 'express'）
    // 同时启用 allowSyntheticDefaultImports
    "esModuleInterop": true,

    // resolveJsonModule — 允许导入 JSON 文件
    // 开启后可以通过 import config from './config.json' 导入 JSON
    // 并自动生成 JSON 文件的类型定义
    "resolveJsonModule": true,

    // skipLibCheck — 跳过所有 .d.ts 声明文件的类型检查
    // 大幅加快编译速度，避免第三方库的类型定义冲突问题
    // 生产项目建议开启，因为第三方库的类型错误通常不由你修复
    "skipLibCheck": true,

    // forceConsistentCasingInFileNames — 强制文件名大小写一致
    // 在 Linux（大小写敏感）和 Windows/macOS（大小写不敏感）之间保持一致
    // 防止因大小写不一致导致的跨平台编译失败
    "forceConsistentCasingInFileNames": true,

    // --------------------------------------------------------------------------
    // 声明文件生成（用于库开发，可选）
    // --------------------------------------------------------------------------

    // declaration — 是否为每个 .ts 文件生成对应的 .d.ts 声明文件
    // 本项目是应用而非库，但生成声明文件有助于 IDE 的自动补全和类型跳转
    "declaration": true,

    // declarationMap — 为声明文件生成 Source Map
    // 使 IDE 可以从 .d.ts 文件跳回原始 .ts 源码，提升调试体验
    "declarationMap": true,

    // sourceMap — 为编译后的 .js 文件生成 Source Map
    // 调试时可以将断点映射回 TypeScript 源码，而非编译后的 JavaScript
    "sourceMap": true
  },

  // ----------------------------------------------------------------------------
  // 包含与排除的文件
  // ----------------------------------------------------------------------------

  // include — 指定哪些文件应被纳入 TypeScript 项目
  // "src/**/*" 包含 src 目录及其所有子目录下的所有 .ts/.tsx 文件
  // "prisma/**/*" 包含 prisma 目录，用于类型感知 lint 时识别 Prisma Client 类型
  "include": ["src/**/*", "prisma/**/*"],

  // exclude — 指定哪些文件/目录应被排除
  // node_modules — 第三方依赖，不应编译
  // dist — 编译输出目录，避免循环编译
  // tests — 测试文件，如果使用 tsx 或 Vitest 直接运行则不需要 tsc 编译
  "exclude": ["node_modules", "dist", "tests"]
}
